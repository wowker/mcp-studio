{
  "version": 1,
  "purpose": "Production M3 canonical digest and typed redaction; literal expectations independent of implementations",
  "canonical": [
    {
      "id": "safe-scalars",
      "raw": "{\"z\":null,\"b\":false,\"n\":0,\"a\":[true,1,\"\"],\"frozenDigest\":\"ignored\"}",
      "expectedCanonical": "{\"a\":[true,1,\"\"],\"b\":false,\"n\":0,\"z\":null}",
      "expectedDigest": "ea9aea17cbb71aefd942c7c25108112887edabe3dbdeb5b2a27def4543c58536"
    },
    {
      "id": "unicode-codepoint-and-no-HTML-escape",
      "raw": "{\"😀\":1,\"\":2,\"a\":\"<>& \",\"z\":-0}",
      "expectedCanonical": "{\"a\":\"<>& \",\"z\":0,\"\":2,\"😀\":1}",
      "expectedDigest": "b1028319712d542be45a2094db64bc25bc6aa2ed7d87c304ad6e1ec034eed4fa"
    },
    {
      "id": "encoded-decimal-payload",
      "raw": "{\"requestJSON\":\"{\\\"n\\\":0.1}\",\"version\":1}",
      "expectedCanonical": "{\"requestJSON\":\"{\\\"n\\\":0.1}\",\"version\":1}",
      "expectedDigest": "884bacb256ed992a7e8855715b40622eaf232d5dbac945c551ed7db80ba34583"
    },
    {
      "id": "outer-decimal-unsupported",
      "raw": "{\"n\":0.1}",
      "error": "unsafe_digest_value"
    },
    {
      "id": "unsafe-integer",
      "raw": "{\"n\":9007199254740992}",
      "error": "unsafe_digest_value"
    },
    {
      "id": "duplicate-key",
      "raw": "{\"x\":1,\"x\":2}",
      "error": "unsafe_digest_value"
    },
    {
      "id": "lone-surrogate",
      "raw": "{\"s\":\"\\ud800\"}",
      "error": "unsafe_digest_value"
    }
  ],
  "redaction": [
    {
      "id": "red-default-nested-secrets",
      "value": {
        "headers": {
          "Authorization": "Bearer fixture",
          "Cookie": "session=fixture"
        },
        "email": "fixture@example.invalid",
        "phone": "13800000000",
        "ok": false
      },
      "options": {},
      "expected": {
        "value": {
          "headers": {
            "Authorization": {
              "$redacted": true
            },
            "Cookie": {
              "$redacted": true
            }
          },
          "email": {
            "$redacted": true
          },
          "phone": {
            "$redacted": true
          },
          "ok": false
        },
        "markers": [
          {
            "path": "/email",
            "reason": "default"
          },
          {
            "path": "/headers/Authorization",
            "reason": "default"
          },
          {
            "path": "/headers/Cookie",
            "reason": "default"
          },
          {
            "path": "/phone",
            "reason": "default"
          }
        ],
        "omitted": false
      }
    },
    {
      "id": "red-derived-secret-echo",
      "value": {
        "safe": "x",
        "echo": [
          "prefix FIXTURE_SECRET suffix"
        ]
      },
      "options": {
        "sensitiveValues": [
          "FIXTURE_SECRET"
        ]
      },
      "expected": {
        "value": {
          "safe": "x",
          "echo": [
            {
              "$redacted": true
            }
          ]
        },
        "markers": [
          {
            "path": "/echo/0",
            "reason": "source"
          }
        ],
        "omitted": false
      }
    },
