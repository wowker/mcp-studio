{
  "name": "mcp-studio",
  "services": {
    "db": {
      "image": "postgres:18@sha256:74935e72241653ca55e0414067e6d8763aceb8a810eb51b452253ec3dcfc4336",
      "environment": {
        "POSTGRES_USER": "mcp_studio_admin",
        "POSTGRES_DB": "mcp_studio",
        "POSTGRES_PASSWORD_FILE": "/run/secrets/admin_db_password"
      },
      "secrets": [
        "admin_db_password",
        "app_db_password"
      ],
      "volumes": [
        "postgres-data:/var/lib/postgresql",
        "./init-db.sh:/docker-entrypoint-initdb.d/10-studio.sh:ro"
      ],
      "healthcheck": {
        "test": [
          "CMD",
          "pg_isready",
          "-U",
          "mcp_studio_admin",
          "-d",
          "mcp_studio"
        ],
        "interval": "3s",
        "timeout": "3s",
        "retries": 20
      },
      "networks": [
        "private"
      ]
    },
    "platform": {
      "image": "${STUDIO_PLATFORM_IMAGE:-mcp-studio-platform:m7-candidate}",
      "build": {
        "context": "..",
        "dockerfile": "deploy/Dockerfile"
      },
      "user": "10001:10001",
      "read_only": true,
      "tmpfs": [
        "/tmp:mode=0700,uid=10001,gid=10001"
      ],
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "environment": {
        "MCP_STUDIO_ORIGIN": "${STUDIO_ORIGIN:?Exact external HTTPS origin required}",
        "MCP_STUDIO_LISTEN": "0.0.0.0:8080",
        "MCP_STUDIO_STATIC_DIR": "/app/web",
        "MCP_STUDIO_DATABASE_URL_FILE": "/run/secrets/database_url",
        "MCP_STUDIO_INIT_CREDENTIAL_FILE": "/run/secrets/init_credential",
        "MCP_STUDIO_SMTP_ADDRESS": "${STUDIO_SMTP_ADDRESS:?STARTTLS SMTP host and port required}",
        "MCP_STUDIO_SMTP_FROM": "${STUDIO_SMTP_FROM:?Sender address required}",
        "MCP_STUDIO_SMTP_USERNAME": "${STUDIO_SMTP_USERNAME:-}"
      },
      "secrets": [
        "database_url",
        "init_credential"
      ],
      "depends_on": {
        "db": {
          "condition": "service_healthy"
        }
      },
      "healthcheck": {
        "test": [
          "CMD",
          "wget",
          "-q",
          "--spider",
          "http://127.0.0.1:8080/api/v1/health"
        ],
        "interval": "3s",
        "timeout": "3s",
        "retries": 20
      },
      "networks": [
        "private"
      ]
    },
    "tls": {
      "image": "caddy:2.10.2-alpine@sha256:4c6e91c6ed0e2fa03efd5b44747b625fec79bc9cd06ac5235a779726618e530d",
      "user": "10001:10001",
      "read_only": true,
      "tmpfs": [
        "/config:uid=10001,gid=10001,mode=0700",
        "/data:uid=10001,gid=10001,mode=0700"
      ],
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "ports": [
        "${STUDIO_BIND_ADDRESS:-127.0.0.1}:${STUDIO_HTTPS_PORT:-8443}:8443"
      ],
      "volumes": [
        "./Caddyfile:/etc/caddy/Caddyfile:ro"
      ],
      "secrets": [
        {
          "source": "tls_cert",
          "target": "/tls/cert.pem"
        },
        {
          "source": "tls_key",
          "target": "/tls/key.pem"
        }
      ],
      "depends_on": {
        "platform": {
          "condition": "service_healthy"
        }
      },
      "networks": [
        "private"
      ],
      "cap_add": [
        "NET_BIND_SERVICE"
      ]
    }
  },
  "secrets": {
    "admin_db_password": {
      "file": "${STUDIO_SECRETS_DIR:?Absolute private secrets directory required}/admin_db_password"
    },
    "app_db_password": {
      "file": "${STUDIO_SECRETS_DIR:?Absolute private secrets directory required}/app_db_password"
    },
    "database_url": {
      "file": "${STUDIO_SECRETS_DIR:?Absolute private secrets directory required}/database_url"
    },
    "init_credential": {
      "file": "${STUDIO_SECRETS_DIR:?Absolute private secrets directory required}/init_credential"
    },
    "tls_cert": {
      "file": "${STUDIO_SECRETS_DIR:?Absolute private secrets directory required}/tls_cert"
    },
    "tls_key": {
      "file": "${STUDIO_SECRETS_DIR:?Absolute private secrets directory required}/tls_key"
    }
  },
  "volumes": {
    "postgres-data": {}
  },
  "networks": {
    "private": {}
  }
}
