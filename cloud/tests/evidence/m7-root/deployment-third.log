export async function compose(directory,project,args,{input,output,quiet=true}={}){const argv=await composeArgs(directory,project,args);const env={...process.env,...await deploymentEnv(directory)};return new Promise((ok,fail)=>{const child=spawn('docker',argv,{env,stdio:['pipe','pipe','pipe']});let data=[];child.stderr.on('data',()=>{});if(output)child.stdout.pipe(output);else child.stdout.on('data',b=>{if(data.reduce((n,x)=>n+x.length,0)+b.length>16*1024*1024){child.kill();return;}data.push(b);});child.once('error',()=>fail(Error('compose transport unavailable')));child.once('exit',code=>code===0?ok(Buffer.concat(data)):fail(Error(`compose command failed (exit ${code})`)));child.stdin.on('error',()=>{});if(input&&typeof input.pipe==='function'){input.on('error',()=>child.kill());input.pipe(child.stdin);}else if(input)child.stdin.end(input);else child.stdin.end();});}
