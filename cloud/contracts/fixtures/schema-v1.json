{
  "version": 1,
  "cases": [
    {
      "id": "2020-unevaluated-properties",
      "schema": {
        "type": "object",
        "allOf": [
          {
            "properties": {
              "a": {
                "type": "number"
              }
            }
          }
        ],
        "unevaluatedProperties": false
      },
      "value": {
        "a": 1,
        "b": 2
      },
      "expected": {
        "supported": true,
        "valid": false,
        "errorPaths": [
          "/b"
        ]
      }
    },
    {
      "id": "2020-unevaluated-allowed",
      "schema": {
        "type": "object",
        "allOf": [
          {
            "properties": {
              "a": {
                "type": "number"
              }
            }
          }
        ],
        "unevaluatedProperties": false
      },
      "value": {
        "a": 1
      },
      "expected": {
        "supported": true,
        "valid": true
      }
    },
    {
      "id": "2020-prefix-items",
      "schema": {
        "type": "array",
        "prefixItems": [
          {
            "type": "string"
          },
          {
            "type": "integer"
          }
        ],
        "items": false
      },
      "value": [
        "ok",
        2,
        3
      ],
      "expected": {
        "supported": true,
        "valid": false,
        "errorPaths": [
          "/2"
        ]
      }
    },
    {
      "id": "2020-contains-count",
      "schema": {
        "type": "array",
        "contains": {
          "type": "integer"
        },
        "minContains": 2,
        "maxContains": 3
      },
      "value": [
        1,
        "s"
      ],
      "expected": {
        "supported": true,
        "valid": false
      }
    },
    {
      "id": "dependent-required",
      "schema": {
        "type": "object",
        "dependentRequired": {
          "a": [
            "b"
          ]
        }
      },
      "value": {
        "a": 1
      },
      "expected": {
        "supported": true,
        "valid": false,
        "errorPaths": [
          "/b"
        ]
      }
    },
    {
      "id": "dependent-schema",
      "schema": {
        "type": "object",
        "dependentSchemas": {
          "a": {
            "required": [
              "b"
            ]
          }
        }
      },
      "value": {
        "a": 1
      },
      "expected": {
        "supported": true,
        "valid": false,
        "errorPaths": [
          "/b"
        ]
      }
    },
    {
      "id": "conditional-branch",
      "schema": {
        "type": "object",
        "if": {
          "properties": {
            "kind": {
              "const": "a"
            }
          },
          "required": [
            "kind"
          ]
        },
        "then": {
          "required": [
            "a"
          ]
        },
        "else": {
          "required": [
            "b"
          ]
        }
      },
      "value": {
        "kind": "a"
      },
      "expected": {
        "supported": true,
        "valid": false,
        "errorPaths": [
          "/a"
        ]
      }
    },
    {
      "id": "embedded-relative-ref",
      "schema": {
        "$id": "https://schema.test/root",
        "$defs": {
          "n": {
            "$id": "number",
            "type": "integer"
          }
        },
        "type": "object",
        "properties": {
          "n": {
            "$ref": "number"
          }
        }
      },
      "value": {
        "n": "bad"
      },
      "expected": {
        "supported": true,
        "valid": false,
        "errorPaths": [
          "/n"
        ]
      }
    },
    {
      "id": "recursive-local-ref",
      "schema": {
        "$defs": {
          "node": {
            "type": "object",
            "properties": {
              "next": {
                "$ref": "#/$defs/node"
              },
              "n": {
                "type": "integer"
              }
            }
          }
        },
        "$ref": "#/$defs/node"
      },
      "value": {
        "next": {
          "n": "bad"
        }
      },
      "expected": {
        "supported": true,
        "valid": false,
        "errorPaths": [
          "/next/n"
        ]
      }
    },
    {
      "id": "dynamic-recursive-ref",
      "schema": {
        "$dynamicAnchor": "node",
        "type": "object",
        "properties": {
          "n": {
            "type": "integer"
          },
          "next": {
            "$dynamicRef": "#node"
          }
        }
      },
      "value": {
        "next": {
          "n": "bad"
        }
      },
      "expected": {
        "supported": true,
        "valid": false,
        "errorPaths": [
          "/next/n"
        ]
      }
    },
    {
      "id": "anchor-local-ref",
      "schema": {
        "$defs": {
          "number": {
            "$anchor": "number",
            "type": "integer"
          }
        },
        "$ref": "#number"
      },
      "value": "bad",
      "expected": {
        "supported": true,
        "valid": false,
        "errorPaths": [
          ""
        ]
      }
    },
    {
      "id": "draft07-tuple",
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "array",
        "items": [
          {
            "type": "string"
          }
        ],
        "additionalItems": false
      },
      "value": [
        "s",
        2
      ],
      "expected": {
        "supported": true,
        "valid": false,
        "errorPaths": [
          "/1"
        ]
      }
    },
    {
      "id": "draft07-dependencies",
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "dependencies": {
          "a": [
            "b"
          ]
        }
      },
      "value": {
        "a": 1
      },
      "expected": {
        "supported": true,
        "valid": false,
        "errorPaths": [
          "/b"
        ]
      }
    },
    {
      "id": "format-annotation",
      "schema": {
        "type": "string",
        "format": "email"
      },
      "value": "not email",
      "expected": {
        "supported": true,
        "valid": true
      }
    },
    {
      "id": "unknown-format",
      "schema": {
        "type": "string",
        "format": "custom"
      },
      "value": "ok",
      "expected": {
        "supported": false,
        "valid": false
      }
    },
    {
      "id": "unknown-keyword",
      "schema": {
        "type": "number",
        "inventedAssertion": true
      },
      "value": 1,
      "expected": {
        "supported": false,
        "valid": false
      }
    },
    {
      "id": "remote-reference",
      "schema": {
        "$ref": "https://remote.test/private"
      },
      "value": 1,
      "expected": {
        "supported": false,
        "valid": false
      }
    },
    {
      "id": "custom-vocabulary",
      "schema": {
        "$vocabulary": {
          "https://custom.test/vocab": true
        }
      },
      "value": 1,
      "expected": {
        "supported": false,
        "valid": false
      }
    },
    {
      "id": "unsupported-dialect",
      "schema": {
        "$schema": "urn:custom"
      },
      "value": 1,
      "expected": {
        "supported": false,
        "valid": false
      }
    },
    {
      "id": "regex-lookaround",
      "schema": {
        "type": "string",
        "pattern": "(?=a)a"
      },
      "value": "a",
      "expected": {
        "supported": false,
        "valid": false
      }
    },
    {
      "id": "regex-backreference",
      "schema": {
        "type": "string",
        "pattern": "(a)\\1"
      },
      "value": "aa",
      "expected": {
        "supported": false,
        "valid": false
      }
    },
    {
      "id": "regex-portable",
      "schema": {
        "type": "string",
        "pattern": "^[a-z]+$"
      },
      "value": "abc",
      "expected": {
        "supported": true,
        "valid": true
      }
    },
    {
      "id": "required-pointer-escaping",
      "schema": {
        "type": "object",
        "required": [
          "a/b",
          "~x"
        ]
      },
      "value": {},
      "expected": {
        "supported": true,
        "valid": false,
        "errorPaths": [
          "/a~1b",
          "/~0x"
        ]
      }
    },
    {
      "id": "anyof-collapse",
      "schema": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "type": "number"
          }
        ]
      },
      "value": false,
      "expected": {
        "supported": true,
        "valid": false,
        "errorPaths": [
          ""
        ]
      }
    },
    {
      "id": "oneof-overlap",
      "schema": {
        "oneOf": [
          {
            "type": "number"
          },
          {
            "minimum": 0
          }
        ]
      },
      "value": 1,
      "expected": {
        "supported": true,
        "valid": false,
        "errorPaths": [
          ""
        ]
      }
    },
    {
      "id": "allof-leaf-errors",
      "schema": {
        "allOf": [
          {
            "type": "string",
            "minLength": 3
          },
          {
            "pattern": "^z"
          }
        ]
      },
      "value": "a",
      "expected": {
        "supported": true,
        "valid": false,
        "errorPaths": [
          ""
        ]
      }
    },
    {
      "id": "invalid-schema",
      "schema": {
        "type": "invalid"
      },
      "value": 1,
      "expected": {
        "supported": false,
        "valid": false
      }
    },
    {
      "id": "annotation-not-schema",
      "schema": {
        "type": "object",
        "default": {
          "inventedAssertion": 1
        },
        "examples": [
          {
            "token": "example"
          }
        ]
      },
      "value": {},
      "expected": {
        "supported": true,
        "valid": true
      }
    },
