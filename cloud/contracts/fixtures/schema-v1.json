    {
      "id": "same-instance-ref-cycle",
      "schema": {
        "$ref": "#"
      },
      "value": {},
      "expected": {
        "supported": false,
        "valid": false
      }
    },
    {
      "id": "structural-recursion-supported",
      "schema": {
        "type": "object",
        "properties": {
          "child": {
            "$ref": "#"
          }
        }
      },
      "value": {
        "child": {
          "child": {}
        }
      },
      "expected": {
        "supported": true,
        "valid": true
      }
    },
    {
      "id": "regex-pattern-budget",
      "schema": {
        "type": "string",
        "pattern": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      },
      "value": "a",
      "expected": {
        "supported": false,
        "valid": false
      }
    },
    {
