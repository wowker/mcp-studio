{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcp-studio.invalid/contracts/semantic-vectors-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contractVersion": {
      "const": "1.0.0"
    },
    "purpose": {
      "type": "string"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "environment",
              "schema",
              "redaction",
              "run",
              "upload",
              "restore",
              "permission"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "input": {
            "type": "object"
          },
          "expected": {}
        },
        "required": [
          "id",
          "kind",
          "source",
          "input",
          "expected"
        ]
      }
    }
  },
  "required": [
    "contractVersion",
    "purpose",
    "cases"
  ]
}
